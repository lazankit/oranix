{
  "manifest_version": 3,
  "name": "Oranix for Chrome",
  "short_name": "Oranix",
  "version": "1.1.0",
  "description": "The Oranix player bar on any web video, with an ad and tracker shield. Play More. Worry Less.",
  "homepage_url": "https://github.com/lazankit/oranix",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["declarativeNetRequest"],
  "declarative_net_request": {
    "rule_resources": [{ "id": "oranix-shield", "enabled": true, "path": "rules.json" }]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["oranix-player.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "minimum_chrome_version": "111"
}
